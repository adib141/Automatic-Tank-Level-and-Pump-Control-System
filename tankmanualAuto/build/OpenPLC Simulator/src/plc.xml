              </type>
            </variable>
            <variable name="level_real">
              <type>
                <DINT/>
              </type>
            </variable>
            <variable name="sensor_fault">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="alarm_light_red">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="sensor_fault_latched">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="sensor_reset">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="START_FAILURE_RESET">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="PUMP_FAULT_ALARM">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="OVERLOAD_FAULT_LATCHED">
              <type>
                <BOOL/>
              </type>
            </variable>
            <variable name="OVERLOAD_RESET">
              <type>
                <BOOL/>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml:p><![CDATA[if STOP then
    SYSTEM_RUN:= false;
elsif START then
     SYSTEM_RUN:= true;
end_if;

IF (level_real < 0) OR (level_real > 32767) THEN
    SENSOR_FAULT_LATCHED := TRUE;
END_IF;

IF sensor_reset AND (level_real >= 0) AND (level_real <= 32767) THEN
    SENSOR_FAULT_LATCHED := FALSE;
END_IF;

sensor_fault := SENSOR_FAULT_LATCHED;

IF sensor_fault THEN
    TANK_LEVEL := -1.0;
    alarm_light_red := TRUE;
ELSE
    TANK_LEVEL := DINT_TO_REAL(level_real) * 100.0 / 32767.0;
    alarm_light_red := FALSE;
END_IF;

IF AUTO_SELECT AND NOT MANUAL_SELECT THEN
    AUTO_MODE := TRUE;
    MANUAL_MODE := FALSE;

ELSIF MANUAL_SELECT AND NOT AUTO_SELECT THEN
    MANUAL_MODE := TRUE;
    AUTO_MODE := FALSE;

ELSIF AUTO_SELECT AND MANUAL_SELECT THEN
    AUTO_MODE := FALSE;
    MANUAL_MODE := FALSE;
END_IF;

IF NOT SYSTEM_RUN THEN
    PUMP := FALSE;
ELSIF sensor_fault THEN
    PUMP := FALSE;

ELSIF AUTO_MODE THEN
    IF TANK_LEVEL <= 30.0 THEN
        PUMP := TRUE;
    ELSIF TANK_LEVEL >= 90.0 THEN
        PUMP := FALSE;
    END_IF;

ELSIF MANUAL_MODE THEN
    IF MANUAL_STOP THEN
        PUMP := FALSE;
    ELSIF MANUAL_START THEN
        PUMP := TRUE;
    END_IF;

ELSE
    PUMP := FALSE;
END_IF;

STARTUP_TIMER (
    IN := PUMP AND NOT PUMP_RUN_FEEDBACK,
    PT := T#3s
);
IF STARTUP_TIMER.Q THEN
    START_FAILURE := TRUE;
END_IF;

IF START_FAILURE_RESET
   AND NOT PUMP
   AND NOT PUMP_RUN_FEEDBACK
   AND NOT OVERLOAD_TRIP
   AND NOT sensor_fault THEN

    START_FAILURE := FALSE;
END_IF;

PUMP_FAULT_ALARM := START_FAILURE OR OVERLOAD_FAULT_LATCHED;

IF sensor_fault OR OVERLOAD_FAULT_LATCHED OR START_FAILURE THEN
    PUMP := FALSE;
END_IF;
IF OVERLOAD_TRIP THEN
    OVERLOAD_FAULT_LATCHED := TRUE;
END_IF;

IF OVERLOAD_TRIP THEN
    OVERLOAD_FAULT_LATCHED := TRUE;
END_IF;

IF OVERLOAD_RESET
   AND NOT OVERLOAD_TRIP
   AND NOT PUMP
   AND NOT PUMP_RUN_FEEDBACK THEN

    OVERLOAD_FAULT_LATCHED := FALSE;
END_IF;]]></xhtml:p>
